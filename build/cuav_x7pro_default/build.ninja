  COMMAND = cd /home/btfw/tpy/px4_net_communication/PX4_Network_communication/build/cuav_x7pro_default/msg && /usr/local/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build msg/install/local: phony msg/CMakeFiles/install/local.util


